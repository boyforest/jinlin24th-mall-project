# ============================================================
# 服务器 .env 模板 —— 复制为 .env 后，把每一项都改成真实值
#   cp .env.example .env && vim .env
#
# 生成强随机值的命令：
#   openssl rand -base64 32      # 用于 JWT_SECRET
#   openssl rand -hex 24         # 用于各密码
#
# 警告：JWT_SECRET / REDIS_PASSWORD / MYSQL_APP_PASSWORD 三项缺一不可，
#       docker-compose 会直接报错拒绝启动（这是刻意设计，避免静默使用弱配置）。
# ============================================================

# ---------- MySQL ----------
# root 只用于运维（备份/迁移），应用不再使用它
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
MYSQL_DATABASE=jinlin24th
MYSQL_HOST_PORT=13306

# 业务账号：backend 用它连接数据库，仅拥有 jinlin24th 库的增删改查权限
# 首次部署由 deploy/mysql/init/04-app-user.sh 自动创建；
# 已有数据的库请手工执行：scripts/create-app-db-user.sh
MYSQL_APP_USER=jinlin_app
MYSQL_APP_PASSWORD=change-this-app-db-password

# ---------- Redis ----------
# 必填：Redis 中保存登录态 jti，配合 JWT 密钥构成完整认证边界
REDIS_PASSWORD=change-this-redis-password
REDIS_DATABASE=1
REDIS_HOST_PORT=16379

# ---------- 后端 ----------
BACKEND_HOST_PORT=7878

SPRING_PROFILES_ACTIVE=prod
# 必填：至少 32 字节。生成方式：openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes
JAVA_OPTS="-Xms256m -Xmx512m"

# 必填：管理后台实际访问地址，多个域名用英文逗号分隔
# 例：https://admin.jinlin24th.com,https://www.jinlin24th.com
# 警告：不要使用 * ，否则任何网站都能跨域携带 cookie 访问你的接口
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 必填：服务器公网访问地址，用于生成上传图片的完整 URL
# 例：https://api.jinlin24th.cn
APP_PUBLIC_URL=https://api.jinlin24th.cn

# ---------- 微信小程序 ----------
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ---------- 微信支付 ----------
# WX_PAY_ENABLED=true 时，以下所有项都必须填写，否则后端会启动失败（fail-fast）
# 注意：回调地址必须与实际域名一致，留空会导致支付成功但订单永远停留在待付款
WX_PAY_ENABLED=false
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_SERIAL_NO=
WX_PAY_PLATFORM_PUBLIC_KEY_ID=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_CERTIFICATE_PATH=
WX_PAY_NOTIFY_URL=https://api.jinlin24th.cn/api/payment/notify
WX_PAY_REFUND_NOTIFY_URL=https://api.jinlin24th.cn/api/payment/refund/notify

# ---------- RocketMQ ----------
# 关闭时没有延迟消息，订单超时取消靠 Spring 定时任务兜底（见下方 ORDER_TIMEOUT_*）。
# 开启前请确认已修复"支付回调与超时取消竞态"（见 docs/launch-readiness-review.md）。
ROCKETMQ_ENABLED=false

# ---------- 订单超时兜底（可选，留空则用默认值） ----------
# 下单即占用库存，超过 ORDER_TIMEOUT_CANCEL_SECONDS 未付款会被自动取消并归还库存。
# 必须与 RocketMQ 延迟消息的延迟时长一致（MQ 开启时）。
ORDER_TIMEOUT_CANCEL_SECONDS=1800
# 兜底扫描间隔（毫秒），默认 5 分钟
ORDER_TIMEOUT_SCAN_INTERVAL_MS=300000
# 单次扫描处理上限，避免一次把全部待付款订单拉进内存
ORDER_TIMEOUT_SCAN_BATCH_SIZE=200
